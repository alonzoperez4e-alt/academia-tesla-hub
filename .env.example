# CDN / Base API URL
# Local backend fallback: http://localhost:8080/api/v1
VITE_API_BASE_URL=https://your-cloudfront-domain.cloudfront.net/api/v1
VITE_WS_BASE_URL=https://your-cloudfront-domain.cloudfront.net

# AWS Cognito Configuration
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=your-user-pool-id
VITE_COGNITO_APP_CLIENT_ID=your-app-client-id
VITE_COGNITO_HOSTED_UI_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
VITE_COGNITO_REDIRECT_SIGN_IN=https://your-cloudfront-domain.cloudfront.net/callback
# Must match a URL registered in the Cognito App Client's logout_urls
VITE_COGNITO_REDIRECT_SIGN_OUT=https://your-cloudfront-domain.cloudfront.net/callback
